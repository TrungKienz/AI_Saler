# PostgreSQL connection string
DATABASE_URL="postgresql://aisaler:aisaler@localhost:5432/aisaler"

# Secret used to sign customer JWT sessions (web login)
JWT_SECRET="change-me-to-a-long-random-string"

# Port the Express API listens on
PORT=4000

# Origin of the web frontend, used for CORS
WEB_ORIGIN="http://localhost:5173"

# --- Third-party source shop (see document.txt) ---
SOURCE_BASE_URL="https://tunvnmmo.duckdns.org"
# Your OWN API key at the source shop. Used to buy products on behalf of customers
# and to check your own source-side wallet balance. Can also be set/edited later
# from the admin Settings page, which takes priority over this value.
SOURCE_API_KEY="paste-your-source-api-key-here"

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN="paste-your-botfather-token-here"

# --- Seed admin account (created automatically on first server start if missing) ---
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-admin-password"
